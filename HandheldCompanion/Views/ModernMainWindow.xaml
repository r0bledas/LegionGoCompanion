                                <Button x:Name="btnCpuBoostOn" Content="On" Width="76" Height="34" Style="{StaticResource TouchButton}" Click="BtnCpuBoost_Click" Tag="1" />
                                <Button x:Name="btnCpuBoostOff" Content="Off" Width="76" Height="34" Style="{StaticResource TouchButton}" Click="BtnCpuBoost_Click" Tag="0" />
                            </StackPanel>
                            <TextBlock Text="• CPU Turbo Boost: Lets the CPU spike up to 5.1 GHz. Turn OFF in GPU-heavy 3D games (Fortnite, AAA titles) so the CPU doesn't steal 5-10W from the Radeon 780M iGPU—giving smoother FPS and lower temps. Keep ON for emulators or desktop speed." FontSize="11" Foreground="#888E9E" TextWrapping="Wrap" Margin="2,0,0,6" />
                            <Grid Grid.IsSharedSizeScope="True" HorizontalAlignment="Left" Margin="-3,0">
