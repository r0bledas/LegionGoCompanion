                                <Button Grid.Column="2" x:Name="btnEpp20" Content="Perf (20)" Height="34" Padding="14,5" Style="{StaticResource TouchButton}" Click="BtnEpp_Click" Tag="20" />
                                <Button Grid.Column="3" x:Name="btnEpp0" Content="Max (0)" Height="34" Padding="14,5" Style="{StaticResource TouchButton}" Click="BtnEpp_Click" Tag="0" />
                            </Grid>
                            <TextBlock Text="• Power Bias (EPP): Controls how aggressively Windows schedules CPU clocks (0 = instant max clock priority, 50 = balanced, 80 = saves CPU power so the GPU gets thermal &amp; wattage priority)." FontSize="11" Foreground="#888E9E" TextWrapping="Wrap" Margin="2,5,0,0" />
                        </StackPanel>
                    </Border>

