                                <Button Grid.Column="7" x:Name="btnGpu2700" Content="2700 MHz" Height="34" Padding="12,5" Style="{StaticResource TouchButton}" Click="BtnGpuClockPreset_Click" Tag="2700" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center">
