<Window x:Class="HandheldCompanion.Views.ModernMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Legion Go Companion"
        Height="620" Width="720"
        MinHeight="500" MinWidth="580"
        WindowStartupLocation="CenterScreen"
        Background="#14161A"
        Foreground="#EDEDED"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Dark ScrollBar Styles -->
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3E4452" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#555D6F" />
        <SolidColorBrush x:Key="ScrollTrackBrush" Color="#181A20" />

        <Style x:Key="ScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="IsTabStop" Value="false" />
            <Setter Property="Focusable" Value="false" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border CornerRadius="4" Background="{StaticResource ScrollThumbBrush}" Width="7" Margin="2,0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="OverridesDefaultStyle" Value="False" />
        </Style>

        <!-- Base Touch Button Style -->
        <Style x:Key="TouchButton" TargetType="Button">
            <Setter Property="Background" Value="#252932" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#383E4C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#323744" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#4C5466" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0078D7" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#0090FF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active/Selected Pill Button Style -->
        <Style x:Key="ActiveTouchButton" TargetType="Button" BasedOn="{StaticResource TouchButton}">
            <Setter Property="Background" Value="#0078D7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#0090FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Stepper Button Style -->
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource TouchButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Modern Dark ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E222A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#0078D7" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2A3446" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsHighlighted" Value="True" />
                                    <Condition Property="IsSelected" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="itemBorder" Property="Background" Value="#0078D7" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252932" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#3E4556" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.Column="2"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="templateRoot"
                                                Background="#252932"
                                                BorderBrush="#3E4556"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="26" />
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="arrow"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#FFFFFF" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="templateRoot" Property="Background" Value="#323744" />
                                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#525B70" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="templateRoot" Property="Background" Value="#2C323E" />
                                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#0090FF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,3,28,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#1E222A"
                                            BorderBrush="#3E4556"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#888E9E" />
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F2F4F8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="4,4,12,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header: Title + Badges -->
            <RowDefinition Height="Auto" />
            <!-- Navigation Tabs -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Border Grid.Row="0" Background="#1A1C22" BorderBrush="#2A2E38" BorderThickness="0,0,0,1" Padding="14,10,14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Legion Go Companion" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <Border Background="#252932" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtVersionTag" Text="v1.3.19" FontSize="11" Foreground="#9EA4B0" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="badgeAdmin" Background="#1C3825" BorderBrush="#2E6B3E" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="4,0">
                        <TextBlock x:Name="txtAdminStatus" Text="Admin: Elevated" FontSize="11" FontWeight="SemiBold" Foreground="#30D158" />
                    </Border>
                    <Border x:Name="badgeVigem" Background="#252932" BorderBrush="#383E4C" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="4,0">
                        <TextBlock x:Name="txtVigemStatus" Text="ViGEm: OK" FontSize="11" Foreground="#9EA4B0" />
                    </Border>
                    <Border x:Name="badgeHidHide" Background="#252932" BorderBrush="#383E4C" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="4,0">
                        <TextBlock x:Name="txtHidHideStatus" Text="HidHide: OK" FontSize="11" Foreground="#9EA4B0" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Navigation Tab Bar -->
        <Border Grid.Row="1" Background="#17191F" BorderBrush="#262A34" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="navGeneral" Content="General" Width="105" Height="36" Style="{StaticResource ActiveTouchButton}" Click="NavGeneral_Click" />
                <Button x:Name="navController" Content="Controller" Width="105" Height="36" Style="{StaticResource TouchButton}" Click="NavController_Click" />
                <Button x:Name="navSettings" Content="Settings" Width="105" Height="36" Style="{StaticResource TouchButton}" Click="NavSettings_Click" />
            </StackPanel>
        </Border>

        <!-- 3. Scrollable Content Area -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,10">
            <Grid>
                <!-- TAB 1: GENERAL VIEW -->
                <StackPanel x:Name="panelGeneral" Visibility="Visible">
                    <!-- Controller Emulation Mode -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Controller Emulation Mode" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                            <WrapPanel Margin="-2">
                                <Button x:Name="btnModeDesktop" Content="Desktop (Mouse)" MinWidth="130" Height="38" Style="{StaticResource TouchButton}" Click="BtnModeDesktop_Click" />
                                <Button x:Name="btnModeX360" Content="Xbox 360 (x360)" MinWidth="130" Height="38" Style="{StaticResource TouchButton}" Click="BtnModeX360_Click" />
                                <Button x:Name="btnModeDS4" Content="DualShock 4 (DS4)" MinWidth="140" Height="38" Style="{StaticResource TouchButton}" Click="BtnModeDS4_Click" />
                                <Button x:Name="btnModeNative" Content="Native Direct" MinWidth="110" Height="38" Style="{StaticResource TouchButton}" Click="BtnModeNative_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="txtModeHint" Text="Active Mode: Xbox 360" FontSize="11.5" Foreground="#0090FF" Margin="4,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- TDP Power Limit (NO SLIDERS) -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="TDP Power Limit (RyzenSMU &amp; Lenovo EC)" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                            <WrapPanel Margin="-2">
                                <Button x:Name="btnTdp10" Content="10" MinWidth="68" Height="36" Style="{StaticResource TouchButton}" Click="BtnTdpPreset_Click" Tag="10" />
                                <Button x:Name="btnTdp15" Content="15" MinWidth="68" Height="36" Style="{StaticResource TouchButton}" Click="BtnTdpPreset_Click" Tag="15" />
                                <Button x:Name="btnTdp20" Content="20" MinWidth="68" Height="36" Style="{StaticResource TouchButton}" Click="BtnTdpPreset_Click" Tag="20" />
                                <Button x:Name="btnTdp25" Content="25" MinWidth="68" Height="36" Style="{StaticResource TouchButton}" Click="BtnTdpPreset_Click" Tag="25" />
                                <Button x:Name="btnTdp30" Content="30" MinWidth="68" Height="36" Style="{StaticResource TouchButton}" Click="BtnTdpPreset_Click" Tag="30" />
                                <Button x:Name="btnTdp35" Content="35" MinWidth="68" Height="36" Style="{StaticResource TouchButton}" Click="BtnTdpPreset_Click" Tag="35" />
                            </WrapPanel>
                            <!-- Custom Stepper (NO SLIDERS) -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Custom Step:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="2,0,10,0" />
                                <Button x:Name="btnTdpMinus" Content="-" Style="{StaticResource StepButton}" Click="BtnTdpMinus_Click" />
                                <Border Background="#252932" BorderBrush="#383E4C" BorderThickness="1" CornerRadius="6" MinWidth="65" Height="34" Margin="3" Padding="8,0">
                                    <TextBlock x:Name="txtTdpCurrent" Text="15W" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button x:Name="btnTdpPlus" Content="+" Style="{StaticResource StepButton}" Click="BtnTdpPlus_Click" />
                                <TextBlock x:Name="txtTdpModeDesc" Text="Balanced Mode (White Power LED)" FontSize="11.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="14,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Fan Mode (NO SLIDERS) -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Fan Speed &amp; Curve" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                            <WrapPanel Margin="-2">
                                <Button x:Name="btnFanAuto" Content="Auto (Smart Fan)" MinWidth="130" Height="36" Style="{StaticResource ActiveTouchButton}" Click="BtnFanAuto_Click" />
                                <Button x:Name="btnFanFull" Content="Full Speed (100%)" MinWidth="135" Height="36" Style="{StaticResource TouchButton}" Click="BtnFanFull_Click" />
                                <Button x:Name="btnFan50" Content="Fixed 50%" MinWidth="85" Height="36" Style="{StaticResource TouchButton}" Click="BtnFanPreset_Click" Tag="50" />
                                <Button x:Name="btnFan75" Content="Fixed 75%" MinWidth="85" Height="36" Style="{StaticResource TouchButton}" Click="BtnFanPreset_Click" Tag="75" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Display Resolution -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Display Resolution" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                            <WrapPanel Margin="-2">
                                <Button x:Name="btnRes800" Content="1280x800 (800p)" MinWidth="125" Height="36" Style="{StaticResource TouchButton}" Click="BtnRes_Click" Tag="800" />
                                <Button x:Name="btnRes1200" Content="1920x1200 (1200p)" MinWidth="135" Height="36" Style="{StaticResource TouchButton}" Click="BtnRes_Click" Tag="1200" />
                                <Button x:Name="btnRes1440" Content="2560x1440 (1440p)" MinWidth="135" Height="36" Style="{StaticResource TouchButton}" Click="BtnRes_Click" Tag="1440" />
                                <Button x:Name="btnRes1600" Content="2560x1600 (1600p)" MinWidth="135" Height="36" Style="{StaticResource TouchButton}" Click="BtnRes_Click" Tag="1600" />
                            </WrapPanel>
                            <TextBlock x:Name="txtCurrentRes" Text="Current: Checking..." FontSize="11.5" Foreground="#9EA4B0" Margin="4,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- TAB 2: CONTROLLER VIEW -->
                <StackPanel x:Name="panelController" Visibility="Collapsed">
                    <!-- Gyro Aiming -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Gyro Aiming (DualShock 4 Motion Feed)" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnGyroOn" Content="On" Width="75" Height="34" Style="{StaticResource TouchButton}" Click="BtnGyroOn_Click" />
                                <Button x:Name="btnGyroOff" Content="Off" Width="75" Height="34" Style="{StaticResource ActiveTouchButton}" Click="BtnGyroOff_Click" />
                            </StackPanel>
                            <TextBlock x:Name="txtGyroStatus" Text="Gyro Aiming is Off." FontSize="11.5" Foreground="#9EA4B0" Margin="4,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Joystick LED Lighting (NO SLIDERS) -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Joystick LED Lighting (RGB Rings)" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />

                            <!-- Row 1: Power & Effects -->
                            <WrapPanel Margin="-2" VerticalAlignment="Center">
                                <Button x:Name="btnLedOn" Content="On" Width="60" Height="32" Style="{StaticResource TouchButton}" Click="BtnLedOn_Click" />
                                <Button x:Name="btnLedOff" Content="Off" Width="60" Height="32" Style="{StaticResource TouchButton}" Click="BtnLedOff_Click" />
                                <TextBlock Text="Effect:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="10,0,4,0" />
                                <Button x:Name="btnLedSolid" Content="Solid" MinWidth="55" Height="32" Style="{StaticResource TouchButton}" Click="BtnLedEffect_Click" Tag="1" />
                                <Button x:Name="btnLedPulse" Content="Pulse" MinWidth="55" Height="32" Style="{StaticResource TouchButton}" Click="BtnLedEffect_Click" Tag="2" />
                                <Button x:Name="btnLedDynamic" Content="Dynamic" MinWidth="68" Height="32" Style="{StaticResource TouchButton}" Click="BtnLedEffect_Click" Tag="3" />
                                <Button x:Name="btnLedSpiral" Content="Spiral" MinWidth="58" Height="32" Style="{StaticResource TouchButton}" Click="BtnLedEffect_Click" Tag="4" />
                            </WrapPanel>

                            <!-- Row 2: Brightness & Speed Steppers (NO SLIDERS) -->
                            <WrapPanel Margin="-2,8,-2,0" VerticalAlignment="Center">
                                <TextBlock Text="Brightness:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="4,0,6,0" />
                                <Button x:Name="btnBrightMinus" Content="-" Style="{StaticResource StepButton}" Width="32" Height="30" Click="BtnBrightMinus_Click" />
                                <Border Background="#252932" BorderBrush="#383E4C" BorderThickness="1" CornerRadius="4" MinWidth="48" Height="30" Margin="2" Padding="4,0">
                                    <TextBlock x:Name="txtLedBrightness" Text="80%" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button x:Name="btnBrightPlus" Content="+" Style="{StaticResource StepButton}" Width="32" Height="30" Click="BtnBrightPlus_Click" />

                                <TextBlock Text="Speed:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="14,0,6,0" />
                                <Button x:Name="btnSpeedMinus" Content="-" Style="{StaticResource StepButton}" Width="32" Height="30" Click="BtnSpeedMinus_Click" />
                                <Border Background="#252932" BorderBrush="#383E4C" BorderThickness="1" CornerRadius="4" MinWidth="48" Height="30" Margin="2" Padding="4,0">
                                    <TextBlock x:Name="txtLedSpeed" Text="50%" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button x:Name="btnSpeedPlus" Content="+" Style="{StaticResource StepButton}" Width="32" Height="30" Click="BtnSpeedPlus_Click" />
                            </WrapPanel>

                            <!-- Row 3: Color Presets -->
                            <WrapPanel Margin="-2,8,-2,0" VerticalAlignment="Center">
                                <TextBlock Text="Presets:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="4,0,6,0" />
                                <Button Content="Blue" Height="28" Padding="10,2" Style="{StaticResource TouchButton}" Click="BtnColorPreset_Click" Tag="#0078D7" />
                                <Button Content="Cyan" Height="28" Padding="10,2" Style="{StaticResource TouchButton}" Click="BtnColorPreset_Click" Tag="#00E5FF" />
                                <Button Content="Red" Height="28" Padding="10,2" Style="{StaticResource TouchButton}" Click="BtnColorPreset_Click" Tag="#FF1E1E" />
                                <Button Content="Green" Height="28" Padding="10,2" Style="{StaticResource TouchButton}" Click="BtnColorPreset_Click" Tag="#00E676" />
                                <Button Content="Purple" Height="28" Padding="10,2" Style="{StaticResource TouchButton}" Click="BtnColorPreset_Click" Tag="#AA00FF" />
                                <Button Content="Orange" Height="28" Padding="10,2" Style="{StaticResource TouchButton}" Click="BtnColorPreset_Click" Tag="#FF9100" />
                                <Button Content="Yellow" Height="28" Padding="10,2" Style="{StaticResource TouchButton}" Click="BtnColorPreset_Click" Tag="#FFD600" />
                                <Button Content="White" Height="28" Padding="10,2" Style="{StaticResource TouchButton}" Click="BtnColorPreset_Click" Tag="#FFFFFF" />
                            </WrapPanel>

                            <!-- Row 4: Custom Color & Sync -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <Border x:Name="swatchLeft" Width="26" Height="26" Background="#0078D7" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="4" Margin="4,0,6,0" />
                                <Button x:Name="btnCustomLeft" Content="Pick Color..." Height="30" Padding="10,0" Style="{StaticResource TouchButton}" Click="BtnCustomLeft_Click" />
                                <CheckBox x:Name="chkSyncLR" Content="Sync Left &amp; Right Joysticks" IsChecked="True" Margin="14,0,8,0" Click="ChkSyncLR_Click" />
                                <Border x:Name="swatchRight" Width="26" Height="26" Background="#0078D7" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="4" Margin="10,0,6,0" Visibility="Collapsed" />
                                <Button x:Name="btnCustomRight" Content="Right Color..." Height="30" Padding="10,0" Style="{StaticResource TouchButton}" Click="BtnCustomRight_Click" Visibility="Collapsed" />
                            </StackPanel>

                            <TextBlock x:Name="txtLedStatus" Text="Active: Solid Color | RGB(0, 120, 215) | Brightness 80%" FontSize="11.5" Foreground="#30D158" Margin="4,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Pointer Mode (Right Controller Gyro Air Mouse) (NO SLIDERS) -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Pointer Mode (Right Controller Gyro Air Mouse)" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                            <TextBlock Text="Uses detached right controller gyro for air-mouse pointing. RT is primary click, RB is secondary click." FontSize="11.5" Foreground="#9EA4B0" Margin="0,0,0,8" />

                            <WrapPanel Margin="0,0,0,6">
                                <CheckBox x:Name="chkPointerDetachedOnly" Content="Only active when detached" Click="PointerOption_Changed" />
                                <CheckBox x:Name="chkPointerRightClickRB" Content="Right Click on RB" Click="PointerOption_Changed" />
                                <CheckBox x:Name="chkPointerInvertX" Content="Invert X" Click="PointerOption_Changed" />
                                <CheckBox x:Name="chkPointerInvertY" Content="Invert Y" Click="PointerOption_Changed" />
                            </WrapPanel>

                            <!-- Pointer Controls & Speed Stepper (NO SLIDERS) -->
                            <WrapPanel Margin="-2,2,-2,0" VerticalAlignment="Center">
                                <TextBlock Text="Activation:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="4,0,4,0" />
                                <ComboBox x:Name="cmbPointerBtn" Width="150" Margin="2,0,10,0" SelectionChanged="CmbPointerBtn_SelectionChanged">
                                    <ComboBoxItem Content="M1 (Upper Back)" />
                                    <ComboBoxItem Content="M2 (Lower Back)" />
                                    <ComboBoxItem Content="M3 (Side/Bottom)" />
                                    <ComboBoxItem Content="Right Stick Click (RS)" />
                                    <ComboBoxItem Content="Right Bumper (RB)" />
                                    <ComboBoxItem Content="Y3 (Lower Right Back)" />
                                    <ComboBoxItem Content="Always Active" />
                                </ComboBox>

                                <TextBlock Text="Type:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="4,0,4,0" />
                                <ComboBox x:Name="cmbPointerType" Width="120" Margin="2,0,10,0" SelectionChanged="CmbPointerType_SelectionChanged">
                                    <ComboBoxItem Content="Hold to Aim" />
                                    <ComboBoxItem Content="Toggle On/Off" />
                                    <ComboBoxItem Content="Always Active" />
                                </ComboBox>

                                <TextBlock Text="Speed:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="4,0,4,0" />
                                <Button x:Name="btnPointerSensMinus" Content="-" Style="{StaticResource StepButton}" Width="32" Height="30" Click="BtnPointerSensMinus_Click" />
                                <Border Background="#252932" BorderBrush="#383E4C" BorderThickness="1" CornerRadius="4" MinWidth="45" Height="30" Margin="2" Padding="4,0">
                                    <TextBlock x:Name="txtPointerSens" Text="1.0x" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button x:Name="btnPointerSensPlus" Content="+" Style="{StaticResource StepButton}" Width="32" Height="30" Click="BtnPointerSensPlus_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Hold to Cycle Controller Modes (NO SLIDERS) -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Hold to Cycle Controller Modes" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                            <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                                <CheckBox x:Name="chkHoldCycleEnabled" Content="Enable Hold to Cycle" Click="HoldCycleConfig_Changed" />
                                <TextBlock Text="Trigger:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="8,0,4,0" />
                                <ComboBox x:Name="cmbTriggerBtn" Width="150" Margin="2,0,10,0" SelectionChanged="HoldCycleConfig_Changed" />

                                <TextBlock Text="Hold Time:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="4,0,4,0" />
                                <Button x:Name="btnHoldMinus" Content="-" Style="{StaticResource StepButton}" Width="32" Height="30" Click="BtnHoldMinus_Click" />
                                <Border Background="#252932" BorderBrush="#383E4C" BorderThickness="1" CornerRadius="4" MinWidth="58" Height="30" Margin="2" Padding="4,0">
                                    <TextBlock x:Name="txtHoldTime" Text="500ms" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button x:Name="btnHoldPlus" Content="+" Style="{StaticResource StepButton}" Width="32" Height="30" Click="BtnHoldPlus_Click" />
                            </WrapPanel>

                            <WrapPanel Margin="0,4,0,4" VerticalAlignment="Center">
                                <TextBlock Text="Included Modes:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <CheckBox x:Name="chkCycleDesktop" Content="Desktop" Click="HoldCycleConfig_Changed" />
                                <CheckBox x:Name="chkCycleX360" Content="x360" Click="HoldCycleConfig_Changed" />
                                <CheckBox x:Name="chkCycleDS4" Content="DS4" Click="HoldCycleConfig_Changed" />
                                <CheckBox x:Name="chkCycleNative" Content="Native" Click="HoldCycleConfig_Changed" />
                                <CheckBox x:Name="chkCyclePointer" Content="Pointer" Click="HoldCycleConfig_Changed" />
                            </WrapPanel>
                            <TextBlock x:Name="txtCycleSummary" Text="Cycle sequence: Desktop -> x360 -> Desktop" FontSize="11.5" FontWeight="SemiBold" Foreground="#0090FF" Margin="4,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Button Remapping (NO SLIDERS) -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Button Remapping (Legion &amp; Back Buttons)" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                <Button x:Name="btnResetRemap" Content="Reset All" Width="90" Height="28" Style="{StaticResource TouchButton}" HorizontalAlignment="Right" Click="BtnResetRemap_Click" />
                            </Grid>
                            <StackPanel x:Name="stackRemapRows" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- TAB 3: SETTINGS VIEW -->
                <StackPanel x:Name="panelSettings" Visibility="Collapsed">
                    <!-- Hardware & Battery Options -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Hardware &amp; Battery Options" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                            <CheckBox x:Name="chkBatteryLimit" Content="80% Battery Charge Limit (Protects battery longevity)" Click="ChkBatteryLimit_Click" />
                            <CheckBox x:Name="chkCloseMinimises" Content="Keep running in system tray after closing window" Click="ChkCloseMinimises_Click" />
                            <CheckBox x:Name="chkRunAtStartup" Content="Run at Startup (Elevated via Task Scheduler)" Click="ChkRunAtStartup_Click" />
                            <CheckBox x:Name="chkStartMinimized" Content="Silent Launch on Startup (Start minimized in tray)" Click="ChkStartMinimized_Click" />
                            <CheckBox x:Name="chkDesktopOnStart" Content="Default to Desktop Layout on Startup" Click="ChkDesktopOnStart_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Utilities & Diagnostics -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Utilities &amp; Diagnostics" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open Logs Directory" Height="34" Padding="14,0" Style="{StaticResource TouchButton}" Click="BtnOpenLogs_Click" />
                                <Button Content="Restart Companion" Height="34" Padding="14,0" Style="{StaticResource TouchButton}" Click="BtnRestartApp_Click" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Software Updates -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Software Updates (GitHub Releases)" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                            <TextBlock x:Name="txtCurrentVerSettings" Text="Current Version: v1.3.19" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                            <TextBlock x:Name="txtUpdateStatus" Text="Click 'Check Updates' to check for newer releases." FontSize="11.5" Foreground="#9EA4B0" Margin="0,0,0,8" />
                            <ProgressBar x:Name="progressUpdate" Height="10" Maximum="100" Margin="0,0,0,8" Visibility="Collapsed" Foreground="#0078D7" Background="#252932" BorderBrush="#383E4C" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnCheckUpdates" Content="Check Updates" Height="34" Padding="14,0" Style="{StaticResource TouchButton}" Click="BtnCheckUpdates_Click" />
                                <Button x:Name="btnInstallUpdate" Content="Install Update" Height="34" Padding="14,0" Style="{StaticResource ActiveTouchButton}" Click="BtnInstallUpdate_Click" Visibility="Collapsed" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 4. Bottom Status Bar -->
        <Border Grid.Row="3" Background="#16181D" BorderBrush="#262A34" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="lblBottomAdmin" Text="Admin: Elevated" FontSize="11" FontWeight="SemiBold" Foreground="#30D158" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button x:Name="btnElevate" Content="Restart as Admin" Height="24" Padding="8,0" FontSize="10.5" Style="{StaticResource TouchButton}" Click="BtnElevate_Click" Visibility="Collapsed" />
                </StackPanel>

                <TextBlock x:Name="lblBottomHealth" Grid.Column="1" Text="ViGEm: OK  |  HidHide: OK  |  Controller: OK" FontSize="11" Foreground="#888E9E" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
