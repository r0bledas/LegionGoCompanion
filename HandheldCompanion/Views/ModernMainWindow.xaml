<Window x:Class="HandheldCompanion.Views.ModernMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HandheldCompanion.Views"
        Title="Legion Go Companion"
        Icon="/HandheldCompanion;component/Resources/icon.png"
        Height="620" Width="720"
        MinHeight="500" MinWidth="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Background="#14161A"
        Foreground="#EDEDED"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        Stylus.IsPressAndHoldEnabled="False"
        Stylus.IsFlicksEnabled="False"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Dark Custom ScrollBar Styles (No legacy Windows chrome/arrows) -->
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#454C5E" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#636D85" />
        <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#0078D7" />
        <SolidColorBrush x:Key="ScrollTrackBrush" Color="#181A20" />

        <Style x:Key="ModernScrollBarPageButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbRect"
                                CornerRadius="4"
                                Background="{StaticResource ScrollThumbBrush}"
                                Margin="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbRect" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbRect" Property="Background" Value="{StaticResource ScrollThumbDragBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="9" />
                    <Setter Property="MinWidth" Value="9" />
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Border Background="{StaticResource ScrollTrackBrush}" CornerRadius="4" Margin="1,4">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ModernScrollBarPageButton}" Command="ScrollBar.PageUpCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ModernScrollBarPageButton}" Command="ScrollBar.PageDownCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="9" />
                    <Setter Property="MinHeight" Value="9" />
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Border Background="{StaticResource ScrollTrackBrush}" CornerRadius="4" Margin="4,1">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ModernScrollBarPageButton}" Command="ScrollBar.PageLeftCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ModernScrollBarPageButton}" Command="ScrollBar.PageRightCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="OverridesDefaultStyle" Value="False" />
            <Setter Property="PanningMode" Value="VerticalOnly" />
            <Setter Property="PanningDeceleration" Value="0.001" />
            <Setter Property="PanningRatio" Value="1" />
        </Style>

        <!-- Window Caption Buttons -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C4C9D4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="local:TouchHoverHelper.TrackHover" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="local:TouchHoverHelper.IsHovered" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2D323E" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3A4150" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="local:TouchHoverHelper.IsHovered" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#9E2216" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base Touch Button Style -->
        <Style x:Key="TouchButton" TargetType="Button">
            <Setter Property="Background" Value="#252932" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#383E4C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="local:TouchHoverHelper.TrackHover" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="local:TouchHoverHelper.IsHovered" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#323744" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#4C5466" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0078D7" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#0090FF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active/Selected Pill Button Style (Retains active blue highlight even when mouse hovers after touch) -->
        <Style x:Key="ActiveTouchButton" TargetType="Button" BasedOn="{StaticResource TouchButton}">
            <Setter Property="Background" Value="#0078D7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#33A8FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="local:TouchHoverHelper.IsHovered" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0E84E4" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#66C2FF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0066B8" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#33A8FF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stepper Button Style -->
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource TouchButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Modern Dark ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E222A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#0078D7" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2A3446" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsHighlighted" Value="True" />
                                    <Condition Property="IsSelected" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="itemBorder" Property="Background" Value="#0078D7" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252932" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#3E4556" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.Column="2"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="templateRoot"
                                                Background="#252932"
                                                BorderBrush="#3E4556"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="26" />
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="arrow"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#FFFFFF" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="templateRoot" Property="Background" Value="#323744" />
                                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#525B70" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="templateRoot" Property="Background" Value="#2C323E" />
                                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#0090FF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,3,28,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#1E222A"
                                            BorderBrush="#3E4556"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#888E9E" />
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F2F4F8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="4,4,12,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border x:Name="windowFrame" BorderBrush="#2A2E38" BorderThickness="1" Background="#14161A">
        <Grid x:Name="rootGrid">
            <Grid.RowDefinitions>
                <!-- Header: Title + Badges + Window Caption Controls -->
                <RowDefinition Height="Auto" />
                <!-- Navigation Tabs -->
                <RowDefinition Height="Auto" />
                <!-- Main Content Area -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Header Bar (Acts as Window Titlebar via WindowChrome) -->
            <Border Grid.Row="0" Background="#1A1C22" BorderBrush="#2A2E38" BorderThickness="0,0,0,1" Padding="14,6,8,6" Height="44">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/HandheldCompanion;component/Resources/icon.png" Width="24" Height="24" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                        <TextBlock Text="Legion Go Companion" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <Border Background="#252932" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtVersionTag" Text="v1.5.6" FontSize="11" Foreground="#9EA4B0" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Border x:Name="badgeAdmin" Background="#1C3825" BorderBrush="#2E6B3E" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="3,0">
                            <TextBlock x:Name="txtAdminStatus" Text="Admin: Elevated" FontSize="11" FontWeight="SemiBold" Foreground="#30D158" />
                        </Border>
                        <Button x:Name="btnElevate" Content="Restart as Admin" Height="24" Padding="8,0" Margin="3,0" FontSize="10.5" WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TouchButton}" Click="BtnElevate_Click" Visibility="Collapsed" />
                        <Border x:Name="badgeVigem" Background="#252932" BorderBrush="#383E4C" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="3,0">
                            <TextBlock x:Name="txtVigemStatus" Text="ViGEm: OK" FontSize="11" Foreground="#9EA4B0" />
                        </Border>
                        <Border x:Name="badgeHidHide" Background="#252932" BorderBrush="#383E4C" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="3,0">
                            <TextBlock x:Name="txtHidHideStatus" Text="HidHide: OK" FontSize="11" Foreground="#9EA4B0" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnWinMinimize" Content="&#xE921;" Style="{StaticResource CaptionButton}" ToolTip="Minimize" Click="BtnWinMinimize_Click" />
                        <Button x:Name="btnWinMaxRestore" Content="&#xE923;" Style="{StaticResource CaptionButton}" ToolTip="Restore" Click="BtnWinMaxRestore_Click" />
                        <Button x:Name="btnWinClose" Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" ToolTip="Close" Click="BtnWinClose_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Navigation Tab Bar -->
            <Border Grid.Row="1" Background="#17191F" BorderBrush="#262A34" BorderThickness="0,0,0,1" Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="navGeneral" Content="General" Width="92" Height="34" Style="{StaticResource ActiveTouchButton}" Click="NavGeneral_Click" />
                    <Button x:Name="navGraphics" Content="Graphics" Width="94" Height="34" Style="{StaticResource TouchButton}" Click="NavGraphics_Click" />
                    <Button x:Name="navPerformance" Content="Performance" Width="108" Height="34" Style="{StaticResource TouchButton}" Click="NavPerformance_Click" />
                    <Button x:Name="navController" Content="Controller" Width="98" Height="34" Style="{StaticResource TouchButton}" Click="NavController_Click" />
                    <Button x:Name="navTuning" Content="Deadzones" Width="100" Height="34" Style="{StaticResource TouchButton}" Click="NavTuning_Click" />
                    <Button x:Name="navSettings" Content="Settings" Width="92" Height="34" Style="{StaticResource TouchButton}" Click="NavSettings_Click" />
                </StackPanel>
            </Border>

            <!-- 3. Scrollable Content Area -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          PanningDeceleration="0.001"
                          ManipulationBoundaryFeedback="ScrollViewer_ManipulationBoundaryFeedback"
                          Padding="14,8">
            <Grid>
                <!-- TAB 1: GENERAL VIEW -->
                <StackPanel x:Name="panelGeneral" Visibility="Visible">
                    <!-- Controller Emulation Mode -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,7">
                        <StackPanel>
                            <TextBlock Text="Controller Emulation Mode" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,5" />
                            <Grid Grid.IsSharedSizeScope="True" HorizontalAlignment="Left" Margin="-3,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ModeBtn" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ModeBtn" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ModeBtn" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ModeBtn" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="btnModeDesktop" Content="Desktop" Height="34" Padding="16,5" Style="{StaticResource TouchButton}" Click="BtnModeDesktop_Click" />
                                <Button Grid.Column="1" x:Name="btnModeX360" Content="X360" Height="34" Padding="16,5" Style="{StaticResource TouchButton}" Click="BtnModeX360_Click" />
                                <Button Grid.Column="2" x:Name="btnModeDS4" Content="DS4" Height="34" Padding="16,5" Style="{StaticResource TouchButton}" Click="BtnModeDS4_Click" />
                                <Button Grid.Column="3" x:Name="btnModeNative" Content="Native" Height="34" Padding="16,5" Style="{StaticResource TouchButton}" Click="BtnModeNative_Click" />
                            </Grid>
                            <TextBlock x:Name="txtModeHint" Text="Active Mode: Xbox 360" FontSize="11.5" Foreground="#0090FF" Margin="4,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- TDP Power Limit (NO SLIDERS) -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,7">
                        <StackPanel>
                            <TextBlock Text="TDP Power Limit (RyzenSMU &amp; Lenovo EC)" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,5" />
                            <WrapPanel Margin="-2">
                                <Button x:Name="btnTdp10" Content="10W" MinWidth="68" Height="34" Padding="12,5" Style="{StaticResource TouchButton}" Click="BtnTdpPreset_Click" Tag="10" />
                                <Button x:Name="btnTdp15" Content="15W" MinWidth="68" Height="34" Padding="12,5" Style="{StaticResource TouchButton}" Click="BtnTdpPreset_Click" Tag="15" />
                                <Button x:Name="btnTdp20" Content="20W" MinWidth="68" Height="34" Padding="12,5" Style="{StaticResource TouchButton}" Click="BtnTdpPreset_Click" Tag="20" />
                                <Button x:Name="btnTdp25" Content="25W" MinWidth="68" Height="34" Padding="12,5" Style="{StaticResource TouchButton}" Click="BtnTdpPreset_Click" Tag="25" />
                                <Button x:Name="btnTdp30" Content="30W" MinWidth="68" Height="34" Padding="12,5" Style="{StaticResource TouchButton}" Click="BtnTdpPreset_Click" Tag="30" />
                                <Button x:Name="btnTdp35" Content="35W" MinWidth="68" Height="34" Padding="12,5" Style="{StaticResource TouchButton}" Click="BtnTdpPreset_Click" Tag="35" />
                            </WrapPanel>
