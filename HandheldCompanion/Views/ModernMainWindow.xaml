                                <Button x:Name="btnLedPulse" Content="Pulse" MinWidth="55" Height="32" Style="{StaticResource TouchButton}" Click="BtnLedEffect_Click" Tag="2" />
                                <Button x:Name="btnLedDynamic" Content="Dynamic" MinWidth="68" Height="32" Style="{StaticResource TouchButton}" Click="BtnLedEffect_Click" Tag="3" />
                                <Button x:Name="btnLedSpiral" Content="Spiral" MinWidth="58" Height="32" Style="{StaticResource TouchButton}" Click="BtnLedEffect_Click" Tag="4" />
                            </WrapPanel>

                            <!-- Row 2: Brightness & Speed Steppers (NO SLIDERS) -->
                            <WrapPanel Margin="-2,8,-2,0" VerticalAlignment="Center">
                                <TextBlock Text="Brightness:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="4,0,6,0" />
                                <Button x:Name="btnBrightMinus" Content="-" Style="{StaticResource StepButton}" Width="32" Height="30" Click="BtnBrightMinus_Click" />
                                <Border Background="#252932" BorderBrush="#383E4C" BorderThickness="1" CornerRadius="4" MinWidth="48" Height="30" Margin="2" Padding="4,0">
                                    <TextBlock x:Name="txtLedBrightness" Text="80%" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button x:Name="btnBrightPlus" Content="+" Style="{StaticResource StepButton}" Width="32" Height="30" Click="BtnBrightPlus_Click" />

                                <TextBlock Text="Speed:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="14,0,6,0" />
                                <Button x:Name="btnSpeedMinus" Content="-" Style="{StaticResource StepButton}" Width="32" Height="30" Click="BtnSpeedMinus_Click" />
                                <Border Background="#252932" BorderBrush="#383E4C" BorderThickness="1" CornerRadius="4" MinWidth="48" Height="30" Margin="2" Padding="4,0">
                                    <TextBlock x:Name="txtLedSpeed" Text="50%" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button x:Name="btnSpeedPlus" Content="+" Style="{StaticResource StepButton}" Width="32" Height="30" Click="BtnSpeedPlus_Click" />
                            </WrapPanel>

                            <!-- Row 3: Color Presets -->
                            <WrapPanel Margin="-2,8,-2,0" VerticalAlignment="Center">
                                <TextBlock Text="Presets:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="4,0,6,0" />
                                <Button Content="Blue" Height="28" Padding="10,2" Style="{StaticResource TouchButton}" Click="BtnColorPreset_Click" Tag="#0078D7" />
                                <Button Content="Cyan" Height="28" Padding="10,2" Style="{StaticResource TouchButton}" Click="BtnColorPreset_Click" Tag="#00E5FF" />
                                <Button Content="Red" Height="28" Padding="10,2" Style="{StaticResource TouchButton}" Click="BtnColorPreset_Click" Tag="#FF1E1E" />
                                <Button Content="Green" Height="28" Padding="10,2" Style="{StaticResource TouchButton}" Click="BtnColorPreset_Click" Tag="#00E676" />
                                <Button Content="Purple" Height="28" Padding="10,2" Style="{StaticResource TouchButton}" Click="BtnColorPreset_Click" Tag="#AA00FF" />
                                <Button Content="Orange" Height="28" Padding="10,2" Style="{StaticResource TouchButton}" Click="BtnColorPreset_Click" Tag="#FF9100" />
                                <Button Content="Yellow" Height="28" Padding="10,2" Style="{StaticResource TouchButton}" Click="BtnColorPreset_Click" Tag="#FFD600" />
                                <Button Content="White" Height="28" Padding="10,2" Style="{StaticResource TouchButton}" Click="BtnColorPreset_Click" Tag="#FFFFFF" />
                            </WrapPanel>

                            <!-- Row 4: Custom Color & Sync -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <Border x:Name="swatchLeft" Width="26" Height="26" Background="#0078D7" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="4" Margin="4,0,6,0" />
                                <Button x:Name="btnCustomLeft" Content="Pick Color..." Height="30" Padding="10,0" Style="{StaticResource TouchButton}" Click="BtnCustomLeft_Click" />
                                <CheckBox x:Name="chkSyncLR" Content="Sync Left &amp; Right Joysticks" IsChecked="True" Margin="14,0,8,0" Click="ChkSyncLR_Click" />
                                <Border x:Name="swatchRight" Width="26" Height="26" Background="#0078D7" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="4" Margin="10,0,6,0" Visibility="Collapsed" />
                                <Button x:Name="btnCustomRight" Content="Right Color..." Height="30" Padding="10,0" Style="{StaticResource TouchButton}" Click="BtnCustomRight_Click" Visibility="Collapsed" />
                            </StackPanel>

                            <TextBlock x:Name="txtLedStatus" Text="Active: Solid Color | RGB(0, 120, 215) | Brightness 80%" FontSize="11.5" Foreground="#30D158" Margin="4,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Pointer Mode (Right Controller Gyro Air Mouse) (NO SLIDERS) -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Pointer Mode (Right Controller Gyro Air Mouse)" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                            <TextBlock Text="Uses detached right controller gyro for air-mouse pointing. RT is primary click, RB is secondary click." FontSize="11.5" Foreground="#9EA4B0" Margin="0,0,0,8" />

                            <WrapPanel Margin="0,0,0,6">
                                <CheckBox x:Name="chkPointerDetachedOnly" Content="Only active when detached" Click="PointerOption_Changed" />
                                <CheckBox x:Name="chkPointerRightClickRB" Content="Right Click on RB" Click="PointerOption_Changed" />
                                <CheckBox x:Name="chkPointerInvertX" Content="Invert X" Click="PointerOption_Changed" />
                                <CheckBox x:Name="chkPointerInvertY" Content="Invert Y" Click="PointerOption_Changed" />
                            </WrapPanel>

                            <!-- Pointer Controls & Speed Stepper (NO SLIDERS) -->
                            <WrapPanel Margin="-2,2,-2,0" VerticalAlignment="Center">
                                <TextBlock Text="Activation:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="4,0,4,0" />
                                <ComboBox x:Name="cmbPointerBtn" Width="150" Margin="2,0,10,0" SelectionChanged="CmbPointerBtn_SelectionChanged">
                                    <ComboBoxItem Content="M1 (Upper Back)" />
                                    <ComboBoxItem Content="M2 (Lower Back)" />
                                    <ComboBoxItem Content="M3 (Side/Bottom)" />
                                    <ComboBoxItem Content="Right Stick Click (RS)" />
                                    <ComboBoxItem Content="Right Bumper (RB)" />
                                    <ComboBoxItem Content="Y3 (Lower Right Back)" />
                                    <ComboBoxItem Content="Always Active" />
                                </ComboBox>

                                <TextBlock Text="Type:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="4,0,4,0" />
                                <ComboBox x:Name="cmbPointerType" Width="120" Margin="2,0,10,0" SelectionChanged="CmbPointerType_SelectionChanged">
                                    <ComboBoxItem Content="Hold to Aim" />
                                    <ComboBoxItem Content="Toggle On/Off" />
                                    <ComboBoxItem Content="Always Active" />
                                </ComboBox>

                                <TextBlock Text="Speed:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="4,0,4,0" />
                                <Button x:Name="btnPointerSensMinus" Content="-" Style="{StaticResource StepButton}" Width="32" Height="30" Click="BtnPointerSensMinus_Click" />
                                <Border Background="#252932" BorderBrush="#383E4C" BorderThickness="1" CornerRadius="4" MinWidth="45" Height="30" Margin="2" Padding="4,0">
                                    <TextBlock x:Name="txtPointerSens" Text="1.0x" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button x:Name="btnPointerSensPlus" Content="+" Style="{StaticResource StepButton}" Width="32" Height="30" Click="BtnPointerSensPlus_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Hold to Cycle Controller Modes (NO SLIDERS) -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Hold to Cycle Controller Modes" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                            <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                                <CheckBox x:Name="chkHoldCycleEnabled" Content="Enable Hold to Cycle" Click="HoldCycleConfig_Changed" />
                                <TextBlock Text="Trigger:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="8,0,4,0" />
                                <ComboBox x:Name="cmbTriggerBtn" Width="150" Margin="2,0,10,0" SelectionChanged="HoldCycleConfig_Changed" />

                                <TextBlock Text="Hold Time:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="4,0,4,0" />
                                <Button x:Name="btnHoldMinus" Content="-" Style="{StaticResource StepButton}" Width="32" Height="30" Click="BtnHoldMinus_Click" />
                                <Border Background="#252932" BorderBrush="#383E4C" BorderThickness="1" CornerRadius="4" MinWidth="58" Height="30" Margin="2" Padding="4,0">
                                    <TextBlock x:Name="txtHoldTime" Text="500ms" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button x:Name="btnHoldPlus" Content="+" Style="{StaticResource StepButton}" Width="32" Height="30" Click="BtnHoldPlus_Click" />
                            </WrapPanel>

                            <WrapPanel Margin="0,4,0,4" VerticalAlignment="Center">
                                <TextBlock Text="Included Modes:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <CheckBox x:Name="chkCycleDesktop" Content="Desktop" Click="HoldCycleConfig_Changed" />
                                <CheckBox x:Name="chkCycleX360" Content="x360" Click="HoldCycleConfig_Changed" />
                                <CheckBox x:Name="chkCycleDS4" Content="DS4" Click="HoldCycleConfig_Changed" />
                                <CheckBox x:Name="chkCycleNative" Content="Native" Click="HoldCycleConfig_Changed" />
                                <CheckBox x:Name="chkCyclePointer" Content="Pointer" Click="HoldCycleConfig_Changed" />
                            </WrapPanel>
                            <TextBlock x:Name="txtCycleSummary" Text="Cycle sequence: Desktop -> x360 -> Desktop" FontSize="11.5" FontWeight="SemiBold" Foreground="#0090FF" Margin="4,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Button Remapping (NO SLIDERS) -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Button Remapping (Legion &amp; Back Buttons)" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                <Button x:Name="btnResetRemap" Content="Reset All" Width="90" Height="28" Style="{StaticResource TouchButton}" HorizontalAlignment="Right" Click="BtnResetRemap_Click" />
                            </Grid>
                            <StackPanel x:Name="stackRemapRows" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- TAB 5: DEADZONES & FIRMWARE TUNING VIEW -->
                <StackPanel x:Name="panelTuning" Visibility="Collapsed">
                    <!-- Thumbstick Deadzones & Curves (Controller Firmware) -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,7">
                        <StackPanel>
                            <TextBlock Text="Thumbstick Deadzones &amp; Response Curves (Firmware)" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                            <WrapPanel Margin="-2,0,0,4" VerticalAlignment="Center">
                                <TextBlock Text="Left Stick Deadzone:" Width="138" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="4,0,4,0" />
                                <Button x:Name="btnLStickDz0" Content="0%" MinWidth="52" Height="30" Padding="10,3" Style="{StaticResource TouchButton}" Click="BtnLStickDzPreset_Click" Tag="0" />
                                <Button x:Name="btnLStickDz2" Content="2%" MinWidth="52" Height="30" Padding="10,3" Style="{StaticResource TouchButton}" Click="BtnLStickDzPreset_Click" Tag="2" />
                                <Button x:Name="btnLStickDz4" Content="4%" MinWidth="52" Height="30" Padding="10,3" Style="{StaticResource TouchButton}" Click="BtnLStickDzPreset_Click" Tag="4" />
                                <Button x:Name="btnLStickDz8" Content="8%" MinWidth="52" Height="30" Padding="10,3" Style="{StaticResource TouchButton}" Click="BtnLStickDzPreset_Click" Tag="8" />
                                <Button x:Name="btnLStickDz12" Content="12%" MinWidth="56" Height="30" Padding="10,3" Style="{StaticResource TouchButton}" Click="BtnLStickDzPreset_Click" Tag="12" />
                                <Button Content="-" Width="32" Height="30" Style="{StaticResource StepButton}" Margin="8,2,2,2" Click="BtnLStickDzMinus_Click" />
                                <Border Background="#252932" BorderBrush="#383E4C" BorderThickness="1" CornerRadius="4" MinWidth="48" Height="30" Margin="2" Padding="6,0">
                                    <TextBlock x:Name="txtLStickDz" Text="4%" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button Content="+" Width="32" Height="30" Style="{StaticResource StepButton}" Click="BtnLStickDzPlus_Click" />
                            </WrapPanel>
                            <WrapPanel Margin="-2,0,0,6" VerticalAlignment="Center">
                                <TextBlock Text="Right Stick Deadzone:" Width="138" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="4,0,4,0" />
                                <Button x:Name="btnRStickDz0" Content="0%" MinWidth="52" Height="30" Padding="10,3" Style="{StaticResource TouchButton}" Click="BtnRStickDzPreset_Click" Tag="0" />
                                <Button x:Name="btnRStickDz2" Content="2%" MinWidth="52" Height="30" Padding="10,3" Style="{StaticResource TouchButton}" Click="BtnRStickDzPreset_Click" Tag="2" />
                                <Button x:Name="btnRStickDz4" Content="4%" MinWidth="52" Height="30" Padding="10,3" Style="{StaticResource TouchButton}" Click="BtnRStickDzPreset_Click" Tag="4" />
                                <Button x:Name="btnRStickDz8" Content="8%" MinWidth="52" Height="30" Padding="10,3" Style="{StaticResource TouchButton}" Click="BtnRStickDzPreset_Click" Tag="8" />
                                <Button x:Name="btnRStickDz12" Content="12%" MinWidth="56" Height="30" Padding="10,3" Style="{StaticResource TouchButton}" Click="BtnRStickDzPreset_Click" Tag="12" />
                                <Button Content="-" Width="32" Height="30" Style="{StaticResource StepButton}" Margin="8,2,2,2" Click="BtnRStickDzMinus_Click" />
                                <Border Background="#252932" BorderBrush="#383E4C" BorderThickness="1" CornerRadius="4" MinWidth="48" Height="30" Margin="2" Padding="6,0">
                                    <TextBlock x:Name="txtRStickDz" Text="4%" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button Content="+" Width="32" Height="30" Style="{StaticResource StepButton}" Click="BtnRStickDzPlus_Click" />
                            </WrapPanel>
                            <WrapPanel Margin="-2,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Stick Response Curve:" Width="138" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="4,0,4,0" />
                                <Button x:Name="btnCurve1" Content="Standard" MinWidth="82" Height="30" Padding="12,3" Style="{StaticResource ActiveTouchButton}" Click="BtnStickCurve_Click" Tag="1" />
                                <Button x:Name="btnCurve2" Content="Sensitive (Fast)" MinWidth="108" Height="30" Padding="12,3" Style="{StaticResource TouchButton}" Click="BtnStickCurve_Click" Tag="2" />
                                <Button x:Name="btnCurve3" Content="Delayed (Precision)" MinWidth="124" Height="30" Padding="12,3" Style="{StaticResource TouchButton}" Click="BtnStickCurve_Click" Tag="3" />
                                <Button x:Name="btnCurve4" Content="Smooth" MinWidth="78" Height="30" Padding="12,3" Style="{StaticResource TouchButton}" Click="BtnStickCurve_Click" Tag="4" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Trigger Deadzones & Hair-Trigger Mode (Controller Firmware) -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,7">
                        <StackPanel>
                            <TextBlock Text="LT &amp; RT Trigger Deadzones (Hair-Trigger Firmware Mode)" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                            <WrapPanel Margin="-3,0,0,6">
                                <Button x:Name="btnTrigHair" Content="Hair-Trigger (0-35%)" MinWidth="136" Height="32" Padding="12,4" Style="{StaticResource TouchButton}" Click="BtnTriggerPreset_Click" Tag="0,65" />
                                <Button x:Name="btnTrigFast" Content="Fast Pull (2-65%)" MinWidth="120" Height="32" Padding="12,4" Style="{StaticResource TouchButton}" Click="BtnTriggerPreset_Click" Tag="2,35" />
                                <Button x:Name="btnTrigDefault" Content="Default (5-95%)" MinWidth="112" Height="32" Padding="12,4" Style="{StaticResource ActiveTouchButton}" Click="BtnTriggerPreset_Click" Tag="5,5" />
                                <Button x:Name="btnTrigFull" Content="Full Travel (0-100%)" MinWidth="128" Height="32" Padding="12,4" Style="{StaticResource TouchButton}" Click="BtnTriggerPreset_Click" Tag="0,0" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Start Deadzone:" FontSize="12" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="2,0,6,0" />
                                <Button Content="-" Width="32" Height="30" Style="{StaticResource StepButton}" Click="BtnTrigDzMinus_Click" />
                                <Border Background="#252932" BorderBrush="#383E4C" BorderThickness="1" CornerRadius="4" MinWidth="48" Height="30" Margin="2" Padding="6,0">
                                    <TextBlock x:Name="txtTrigStartDz" Text="5%" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button Content="+" Width="32" Height="30" Style="{StaticResource StepButton}" Click="BtnTrigDzPlus_Click" />

                                <TextBlock Text="Full Pull Point:" FontSize="12" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="16,0,6,0" />
                                <Button Content="-" Width="32" Height="30" Style="{StaticResource StepButton}" Click="BtnTrigMaxMinus_Click" />
                                <Border Background="#252932" BorderBrush="#383E4C" BorderThickness="1" CornerRadius="4" MinWidth="54" Height="30" Margin="2" Padding="6,0">
                                    <TextBlock x:Name="txtTrigFullPull" Text="95%" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button Content="+" Width="32" Height="30" Style="{StaticResource StepButton}" Click="BtnTrigMaxPlus_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Trackpad Haptics, FPS Mouse DPI, Auto-Sleep & Button Swap -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,7">
                        <StackPanel>
                            <TextBlock Text="Trackpad Haptics, FPS Mouse DPI &amp; Controller Options" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                            <WrapPanel Margin="-3,0,0,6" VerticalAlignment="Center">
                                <Button x:Name="btnTrackpadToggle" Content="Trackpad: Enabled" MinWidth="132" Height="32" Padding="12,4" Style="{StaticResource ActiveTouchButton}" Click="BtnTrackpadToggle_Click" />
                                <Button x:Name="btnTrackpadVibToggle" Content="Trackpad Haptics: On" MinWidth="144" Height="32" Padding="12,4" Style="{StaticResource ActiveTouchButton}" Click="BtnTrackpadVibToggle_Click" />
                                <Button x:Name="btnSwapLegionButtons" Content="Legion L/R Swap: Normal" MinWidth="162" Height="32" Padding="12,4" Style="{StaticResource TouchButton}" Click="BtnSwapLegionButtons_Click" />
                            </WrapPanel>
                            <CheckBox x:Name="chkKeepTrackpadOnExit" Content="Keep Trackpad Working When App Is Closed" Margin="4,0,0,6" Click="ChkKeepTrackpadOnExit_Click" ToolTip="Restores hardware Windows mouse mode and enables the trackpad on exit so it keeps working after closing the app." />
                            <WrapPanel Margin="-2,0,0,6" VerticalAlignment="Center">
                                <TextBlock Text="FPS Optical Mouse DPI:" Width="145" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="4,0,4,0" />
                                <Button x:Name="btnDpi500" Content="500" MinWidth="58" Height="30" Padding="10,3" Style="{StaticResource TouchButton}" Click="BtnMouseDpi_Click" Tag="500" />
                                <Button x:Name="btnDpi800" Content="800" MinWidth="58" Height="30" Padding="10,3" Style="{StaticResource ActiveTouchButton}" Click="BtnMouseDpi_Click" Tag="800" />
                                <Button x:Name="btnDpi1200" Content="1200" MinWidth="62" Height="30" Padding="10,3" Style="{StaticResource TouchButton}" Click="BtnMouseDpi_Click" Tag="1200" />
                                <Button x:Name="btnDpi1600" Content="1600" MinWidth="62" Height="30" Padding="10,3" Style="{StaticResource TouchButton}" Click="BtnMouseDpi_Click" Tag="1600" />
                                <Button x:Name="btnDpi1800" Content="1800" MinWidth="62" Height="30" Padding="10,3" Style="{StaticResource TouchButton}" Click="BtnMouseDpi_Click" Tag="1800" />
                            </WrapPanel>
                            <WrapPanel Margin="-2,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Controller Auto-Sleep:" Width="145" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="4,0,4,0" />
                                <Button x:Name="btnSleep10" Content="10m" MinWidth="58" Height="30" Padding="10,3" Style="{StaticResource TouchButton}" Click="BtnAutoSleep_Click" Tag="10" />
                                <Button x:Name="btnSleep15" Content="15m" MinWidth="58" Height="30" Padding="10,3" Style="{StaticResource TouchButton}" Click="BtnAutoSleep_Click" Tag="15" />
                                <Button x:Name="btnSleep30" Content="30m" MinWidth="58" Height="30" Padding="10,3" Style="{StaticResource TouchButton}" Click="BtnAutoSleep_Click" Tag="30" />
                                <Button x:Name="btnSleep60" Content="60m" MinWidth="58" Height="30" Padding="10,3" Style="{StaticResource ActiveTouchButton}" Click="BtnAutoSleep_Click" Tag="60" />
                                <Button x:Name="btnSleep0" Content="Never" MinWidth="66" Height="30" Padding="10,3" Style="{StaticResource TouchButton}" Click="BtnAutoSleep_Click" Tag="0" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Hardware Sensor Calibration -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="Hardware Sensor Calibration (Firmware)" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                            <WrapPanel Margin="-3,0,0,4">
                                <Button x:Name="btnCalSticks" Content="Calibrate Sticks (5s)" Height="32" Padding="14,4" Style="{StaticResource TouchButton}" Click="BtnCalibrateSticks_Click" />
                                <Button x:Name="btnCalTriggers" Content="Calibrate Triggers (5s)" Height="32" Padding="14,4" Style="{StaticResource TouchButton}" Click="BtnCalibrateTriggers_Click" />
                                <Button x:Name="btnCalGyro" Content="Calibrate Gyro (3s - Lay Flat)" Height="32" Padding="14,4" Style="{StaticResource TouchButton}" Click="BtnCalibrateGyro_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="txtCalibrationStatus" Text="Ready. Rotate sticks or pull triggers fully 3 times during 5s calibration, then release." FontSize="11.5" Foreground="#9EA4B0" Margin="4,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- TAB 6: SETTINGS VIEW -->
                <StackPanel x:Name="panelSettings" Visibility="Collapsed">
                    <!-- Hardware & Battery Options -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Hardware &amp; Battery Options" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                            <CheckBox x:Name="chkBatteryLimit" Content="80% Battery Charge Limit (Protects battery longevity)" Click="ChkBatteryLimit_Click" />
                            <TextBlock x:Name="txtBatteryLimitStatus" Text="Hardware Charge Limit: Checking..." FontSize="11.5" Foreground="#9EA4B0" Margin="26,-2,0,6" />
                            <CheckBox x:Name="chkPowerLight" Content="Power Button LED Light Enabled (Uncheck to turn off power button LED at night)" IsChecked="True" Click="ChkPowerLight_Click" />
                            <CheckBox x:Name="chkCloseMinimises" Content="Keep running in system tray after closing window" Click="ChkCloseMinimises_Click" />
                            <CheckBox x:Name="chkKeepTrackpadOnExitSettings" Content="Keep trackpad working when app is closed" Click="ChkKeepTrackpadOnExit_Click" ToolTip="Restores hardware Windows mouse mode and enables the trackpad on exit so it keeps working after closing the app." />
                            <CheckBox x:Name="chkRunAtStartup" Content="Run at Startup (Elevated via Task Scheduler)" Click="ChkRunAtStartup_Click" />
                            <CheckBox x:Name="chkStartMinimized" Content="Silent Launch on Startup (Start minimized in tray)" Click="ChkStartMinimized_Click" />
                            <CheckBox x:Name="chkDesktopOnStart" Content="Default to Desktop Layout on Startup" Click="ChkDesktopOnStart_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Speaker EQ & Realtek Audio Fix -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Speaker EQ &amp; Realtek Audio Fix" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                <Button x:Name="btnOpenRealtek" Content="Open Realtek Audio Console" Height="30" Padding="14,4" Style="{StaticResource ActiveTouchButton}" HorizontalAlignment="Right" Click="BtnOpenRealtek_Click" />
                            </Grid>
                            <TextBlock Text="1. In Realtek Audio Control -> Speakers, turn OFF 'Omni Speaker' (eliminates hollow phase cancellation)." FontSize="11.5" Foreground="#9EA4B0" Margin="0,0,0,3" />
                            <TextBlock Text="2. Recommended 10-Band EQ:  31Hz: +1  |  62Hz: +2  |  125Hz: +4  |  250Hz: +6  |  500Hz: +4  |  1kHz: 0  |  2kHz: +4  |  4kHz: -5  |  8kHz: +2  |  16kHz: +4" FontSize="11.5" FontWeight="SemiBold" Foreground="#0090FF" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Volume Step & Minimal ModernFlyout OSD (NO SLIDERS) -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Volume Step &amp; Minimal ModernFlyout OSD" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                            <WrapPanel Margin="-2" VerticalAlignment="Center">
                                <TextBlock Text="OSD:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="4,0,6,0" />
                                <Button x:Name="btnFlyoutOn" Content="On" MinWidth="58" Height="34" Style="{StaticResource ActiveTouchButton}" Click="BtnFlyoutOn_Click" />
                                <Button x:Name="btnFlyoutOff" Content="Off" MinWidth="58" Height="34" Style="{StaticResource TouchButton}" Click="BtnFlyoutOff_Click" />

                                <TextBlock Text="Division Step:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="14,0,6,0" />
                                <Button x:Name="btnVolStep10" Content="10% (10x10)" MinWidth="95" Height="34" Style="{StaticResource ActiveTouchButton}" Click="BtnVolStep_Click" Tag="10" />
                                <Button x:Name="btnVolStep5" Content="5% (20x5)" MinWidth="85" Height="34" Style="{StaticResource TouchButton}" Click="BtnVolStep_Click" Tag="5" />
                                <Button x:Name="btnVolStep2" Content="2% (2x2)" MinWidth="78" Height="34" Style="{StaticResource TouchButton}" Click="BtnVolStep_Click" Tag="2" />
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Volume:" FontSize="12.5" Foreground="#9EA4B0" VerticalAlignment="Center" Margin="2,0,10,0" />
                                <Button x:Name="btnVolDown" Content="-" Style="{StaticResource StepButton}" Click="BtnVolDown_Click" />
                                <Border Background="#252932" BorderBrush="#383E4C" BorderThickness="1" CornerRadius="6" MinWidth="68" Height="34" Margin="3" Padding="8,0">
                                    <TextBlock x:Name="txtVolCurrent" Text="50%" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button x:Name="btnVolUp" Content="+" Style="{StaticResource StepButton}" Click="BtnVolUp_Click" />
                                <Button x:Name="btnVolMute" Content="Mute" MinWidth="68" Height="34" Style="{StaticResource TouchButton}" Margin="8,0,0,0" Click="BtnVolMute_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Utilities & Diagnostics -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Utilities &amp; Diagnostics" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open Logs Directory" Height="34" Padding="14,0" Style="{StaticResource TouchButton}" Click="BtnOpenLogs_Click" />
                                <Button Content="Restart Companion" Height="34" Padding="14,0" Style="{StaticResource TouchButton}" Click="BtnRestartApp_Click" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Software Updates -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Software Updates (GitHub Releases)" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                            <TextBlock x:Name="txtCurrentVerSettings" Text="Current Version: v1.3.19" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                            <TextBlock x:Name="txtUpdateStatus" Text="Click 'Check Updates' to check for newer releases." FontSize="11.5" Foreground="#9EA4B0" Margin="0,0,0,8" />
                            <ProgressBar x:Name="progressUpdate" Height="10" Maximum="100" Margin="0,0,0,8" Visibility="Collapsed" Foreground="#0078D7" Background="#252932" BorderBrush="#383E4C" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnCheckUpdates" Content="Check Updates" Height="34" Padding="14,0" Style="{StaticResource TouchButton}" Click="BtnCheckUpdates_Click" />
                                <Button x:Name="btnInstallUpdate" Content="Install Update" Height="34" Padding="14,0" Style="{StaticResource ActiveTouchButton}" Click="BtnInstallUpdate_Click" Visibility="Collapsed" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
    </Border>
</Window>
