                                    <ColumnDefinition Width="Auto" SharedSizeGroup="EppBtn" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="btnEpp80" Content="Battery (80)" Height="34" Padding="14,5" Style="{StaticResource TouchButton}" Click="BtnEpp_Click" Tag="80" />
