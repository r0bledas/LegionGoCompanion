                </StackPanel>

                <!-- TAB 3: PERFORMANCE VIEW (CPU Boost, EPP, Per-Game Profiles) -->
                <StackPanel x:Name="panelPerformance" Visibility="Collapsed">
                    <!-- CPU Boost & Power Bias (EPP) -->
                    <Border Background="#1C1F26" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,7">
